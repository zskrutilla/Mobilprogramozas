<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:_01_PickerObservableDemo.ViewModels"
             x:Class="_01_PickerObservableDemo.MainPage"
             Title="Picker + ObservableCollection">

    <ScrollView>
        <VerticalStackLayout Padding="30,0"
                             Spacing="25">

            <HorizontalStackLayout Padding="16"
                                   Spacing="8"
                                   BackgroundColor="LightGray">
                <Label Text="Sima adat:" />
                <Label Text="{Binding SimpleText, Mode=OneWay}" />                
            </HorizontalStackLayout>
            
            <Grid Padding="16"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*">
                <Label Text="Személy:"
                       VerticalOptions="Center" />
                <!-- Picker: ObservableCollection → ItemsSource -->
                <Picker Grid.Column="1"
                        Margin="8,0,0,8"
                        ItemsSource="{x:Static vm:MainViewModel.People}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"/>

                <!-- Edition of the selected item TwoWay -->
                <Label Grid.Row="1"
                       Text="Név:"
                       VerticalOptions="Center" />
                <Entry Grid.Row="1"
                       Grid.Column="1"
                       Margin="8,0,0,8"
                       Text="{Binding SelectedPerson.Name, Mode=TwoWay}" />

                <Label Grid.Row="2"
                       Text="Kor:"
                       VerticalOptions="Center" />
                <Entry Grid.Row="2"
                       Grid.Column="1"
                       WidthRequest="100"
                       Margin="8,0,0,0"
                       Keyboard="Numeric"
                       Text="{Binding SelectedPerson.Age, Mode=TwoWay}" />

            </Grid>
            <Button x:Name="addNewBtn"
                    Text="Add new"
                    Clicked="addNewBtn_Clicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
