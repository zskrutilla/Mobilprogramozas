<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helper="clr-namespace:_02_ElementNameDemo.Helpers"
             x:Class="_02_ElementNameDemo.MainPage"
             Title="x:Reference">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helper:ProgressConverter x:Key="ProgressConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    
    <ScrollView>
        <VerticalStackLayout Padding="30,0"
                             Spacing="25">
            <StackLayout Padding="20"
                         Spacing="12">
                <Slider x:Name="slider"
                        Minimum="0"
                        Maximum="100" />
                <!-- We bind to the property of another element with x:Reference -->
                <Label Text="{Binding Source={x:Reference slider}, Path=Value, StringFormat='Érték: {0:F1}%'}" />
                <ProgressBar Progress="{Binding Source={x:Reference slider}, Path=Value, Converter={StaticResource ProgressConverter}}" />
            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
